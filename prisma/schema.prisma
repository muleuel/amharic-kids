generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// A child's local profile. No password — kids pick their profile from a
// friendly avatar grid, keeping sign-in frictionless.
model Kid {
  id        String     @id @default(cuid())
  name      String
  avatar    String     @default("🦁")
  stars     Int        @default(0)
  createdAt DateTime   @default(now())
  progress  Progress[]
  badges    KidBadge[]
}

// A top-level area of the app: Fidel (alphabet), Numbers, Words.
model Subject {
  id      String   @id @default(cuid())
  slug    String   @unique
  name    String
  nameAm  String
  icon    String
  color   String
  order   Int
  lessons Lesson[]
}

enum LessonKind {
  QUIZ
  DIALOGUE
}

// A bite-sized lesson inside a subject, played as one game session. QUIZ
// lessons are driven by `items`; DIALOGUE lessons are driven by
// `dialogueLines` + `dialogueQuestions` instead.
model Lesson {
  id                String             @id @default(cuid())
  subjectId         String
  subject           Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  slug              String
  title             String
  titleAm           String
  order             Int
  kind              LessonKind         @default(QUIZ)
  items             Item[]
  dialogueLines     DialogueLine[]
  dialogueQuestions DialogueQuestion[]
  progress          Progress[]

  @@unique([subjectId, slug])
  @@unique([subjectId, order])
}

// One line of a scripted conversation between two characters.
model DialogueLine {
  id           String @id @default(cuid())
  lessonId     String
  lesson       Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order        Int
  speaker      String
  speakerEmoji String
  am           String
  en           String
}

// A comprehension question about the dialogue above it, multiple choice.
model DialogueQuestion {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order    Int
  prompt   String
  correct  String
  options  Json
}

// A single teachable fact: a Fidel character, a numeral, or a vocabulary
// word. Which fields are populated depends on the parent subject.
model Item {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order    Int

  // Fidel (alphabet)
  symbol String?
  latin  String?
  family String?

  // Numbers
  numeral String?
  value   Int?

  // Words
  wordAm String?
  wordEn String?

  emoji    String?
  category String?
}

// A kid's best result on a lesson, used to unlock stars and drive the
// progress dashboard.
model Progress {
  id        String   @id @default(cuid())
  kidId     String
  kid       Kid      @relation(fields: [kidId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  stars     Int      @default(0)
  bestScore Int      @default(0)
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([kidId, lessonId])
}

// A collectible achievement, e.g. "finished all Fidel lessons".
model Badge {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  nameAm      String
  icon        String
  description String
  kids        KidBadge[]
}

// A full English-headword -> Amharic-translation pair for the general
// dictionary tool. Much larger than the curated `Item` vocabulary used in
// lessons; sourced from a CC0-licensed public dataset (see prisma/seed.ts).
model DictionaryWord {
  id       String @id @default(cuid())
  headword String
  am       String

  @@index([headword])
}

model KidBadge {
  id       String   @id @default(cuid())
  kidId    String
  kid      Kid      @relation(fields: [kidId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@unique([kidId, badgeId])
}
